.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Yerel calisma dizini: yeni oturum ciktilari ve kotu dosyalar izlenmez.
# Depoda tutulanlar (gercek oturum JSON'lari, ekran goruntuleri, RF-DETR
# paketi) zaten izlenir; asagidaki kurallar yeni dosyalari disarida tutar.
data/*
!data/vendor/
data/vendor/*
!data/vendor/rfdetr-1.11.0-py3-none-any.whl

datasets/
runs/
.pio/
*.mp4
*.mov
*.avi

# Indirilen model dosyalari yerelde kalir; yalnizca README, model tanimi ve
# pose modeli Git'te tutulur (pilot kurulumu tek komut calistirsin).
models/*
!models/README.md
!models/pose_landmarker_lite.sha256
!models/pose_landmarker_lite.task
